                      "base_file": "${packages}/LSP-lua/LSP-lua.sublime-settings",
                      "default": "// Settings in here override those in \"LSP-lua/LSP-lua.sublime-settings\"\n\n{\n\t$0\n}\n"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
