  {
    "id": "preferences",
    "children": [
      {
        "caption": "插件设置",
        "mnemonic": "P",
        "id": "package-settings",
        "children": [
          {
            "caption": "LSP",
            "id": "lsp-settings",
            "children": [
              {
                "caption": "设置",
                "command": "edit_settings",
                "args": {
                  "base_file": "${packages}/LSP/LSP.sublime-settings",
                  "default": "// Settings in here override those in \"LSP/LSP.sublime-settings\"\n{\n\t$0\n}\n"
                }
              },
              {
                "caption": "语言服务配置",
                "command": "edit_settings",
                "args": {
                  "base_file": "${packages}/LSP/LanguageServers.sublime-settings",
                  "default": "{\n\t$0\n}\n"
                }
              },
              {
                "caption": "快捷键设置",
                "command": "edit_settings",
                "args": {
                  "base_file": "${packages}/LSP/Default.sublime-keymap",
                  "user_file": "${packages}/User/Default (${platform}).sublime-keymap",
                  "default": "[\n\t$0\n]\n"
                }
              }
            ]
          }
        ]
      }
    ]
